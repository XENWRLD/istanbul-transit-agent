# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is never committed (see .gitignore).
# ---------------------------------------------------------------------------

# Which provider istanbul_agent.llm.get_llm() builds: gemini | ollama
LLM_PROVIDER=gemini

# --- Gemini (free tier) ----------------------------------------------------
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.0

# --- Ollama (local comparison) ---------------------------------------------
# Model must already be pulled: `ollama pull qwen3.5:4b`
# Must match where the Ollama server actually listens. The default is 11434,
# but a machine with OLLAMA_HOST set uses that port instead -- check with
# `echo $env:OLLAMA_HOST` on Windows, and `ollama ps` to confirm it responds.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TEMPERATURE=0.0
# Keeps the model resident so repeated eval runs do not reload it from disk.
OLLAMA_KEEP_ALIVE=24h

# --- Shared LLM settings ---------------------------------------------------
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2

# --- IBB open data ---------------------------------------------------------
# Base host for the live endpoints. No key is required as far as Faz 0
# probing showed; if a service starts demanding one, add it here.
IBB_API_BASE_URL=https://api.ibb.gov.tr
IBB_REQUEST_TIMEOUT=15

# --- Local data stores -----------------------------------------------------
DUCKDB_PATH=data/transit.duckdb
QDRANT_PATH=data/qdrant
