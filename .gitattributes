# Normalize line endings: LF in the repository, native in the working tree.
* text=auto

# Text files that must stay LF even on Windows checkouts
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
.env.example text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# GTFS and tabular data: keep bytes exactly as published
*.csv  text eol=lf
*.geojson text eol=lf

# Binary: never touch
*.zip  binary
*.xlsx binary
*.pdf  binary
*.kml  binary
*.duckdb binary
*.png  binary
*.jpg  binary
